# Переменные для docker compose. Значения ниже подходят для локального запуска как есть:
#   docker compose -f deploy/compose.yaml --env-file deploy/.env.example up -d --build
# Для сервера скопируйте файл в deploy/.env и замените всё, что помечено «сервер».

# Адрес сайта для Caddy. Локально «:80» — обычный HTTP на http://localhost.
# Сервер: домен, на который смотрит A-запись (например, dom.example.ru); Caddy сам получит сертификат.
DOMAIN=:80

# Порты на машине, где запущен compose. Поменяйте, если 80, 443 или 15432 уже заняты.
HTTP_PORT=80
HTTPS_PORT=443
# Postgres открыт только на 127.0.0.1; внутри compose сервисы ходят в базу напрямую.
DB_PORT=15432

# Только для локального запуска. Сервер: свой пароль.
POSTGRES_PASSWORD=dommax-local
# Подпись сессий мини-приложения, не короче 16 символов. Только для локального запуска.
# Сервер: случайная строка (openssl rand -hex 32).
SESSION_SECRET=local-only-session-secret-change-me
# Демо-вход по ролям для проверки без MAX (POST /api/v1/auth/demo, ?demo=resident в браузере).
DEMO_AUTH_ENABLED=true

# Бот: off | polling | webhook. Локально off: бот не нужен, чтобы проверить API и мини-приложение.
# Сервер: webhook, токен бота из кабинета MAX и секрет 5-256 символов из A-Z a-z 0-9 _ -
BOT_MODE=off
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
