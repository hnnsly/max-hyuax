# Скопируйте в deploy/.env и заполните.

# Домен, на который смотрит A-запись VPS. Caddy сам получит сертификат Let's Encrypt.
DOMAIN=

# Появятся на этапе Б (бэкенд). До этого можно не заполнять.
# POSTGRES_PASSWORD=
# MAX_BOT_TOKEN=
# MAX_WEBHOOK_SECRET=
# SESSION_SECRET=
# BOT_MODE=webhook
# DEMO_AUTH_ENABLED=true

# Доступ к platform-api2.max.ru: сертификат Минцифры (PEM). В Docker-образе он уже встроен.
# MAX_API_CA_FILE=
# Только для машины разработчика без сертификата: отключает проверку TLS.
# MAX_API_INSECURE_TLS=false
