# Скопируйте в deploy/.env и заполните.

# Домен, на который смотрит A-запись VPS. Caddy сам получит сертификат Let's Encrypt.
DOMAIN=

# --- Этап Б (бэкенд). Для этапа А (только заглушка) можно не заполнять. ---

# Пароль Postgres. Порт БД наружу не открыт, но пароль всё равно задайте свой.
POSTGRES_PASSWORD=
# Подпись сессий мини-приложения: случайная строка от 16 символов (openssl rand -hex 32).
SESSION_SECRET=
# Демо-вход для проверяющих (POST /api/v1/auth/demo). На демо-стенде true, в остальных случаях false.
DEMO_AUTH_ENABLED=false

# Бот: off | polling | webhook. На сервере webhook; пока он активен, polling у разработчиков не работает.
BOT_MODE=off
MAX_BOT_TOKEN=
# Секрет webhook: 5-256 символов из A-Z a-z 0-9 _ -
MAX_WEBHOOK_SECRET=
