# Переменные для docker compose. Значения ниже подходят для локального запуска как есть:
#   docker compose -f deploy/compose.yaml --env-file deploy/.env.example up -d --build
# Для сервера скопируйте файл в deploy/.env и замените всё, что помечено «сервер».

# Адрес сайта для Caddy. Локально «:80» — обычный HTTP на http://localhost.
# Сервер: домен, на который смотрит A-запись (например, dom.example.ru); Caddy сам получит сертификат.
DOMAIN=:80

# Порты на машине, где запущен compose. Поменяйте, если 80, 443 или 15432 уже заняты.
HTTP_PORT=80
HTTPS_PORT=443
# Порт Postgres наружу на 127.0.0.1 для локального compose.
DB_PORT=15432

# База данных PostgreSQL (на сервере укажите хост, порт, пользователя, пароль и имя БД).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=dommax
POSTGRES_PASSWORD=dommax-local
POSTGRES_DB=dommax
POSTGRES_SSLMODE=disable

# MinIO / S3 для фото к заявкам: S3 API и консоль открыты только на 127.0.0.1 (порты S3_PORT и S3_CONSOLE_PORT).
# Только для локального запуска. Сервер: свой логин и пароль не короче 8 символов.
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=dommax
S3_SECRET_KEY=dommax-local-only
S3_BUCKET=photos
S3_USE_SSL=false
MINIO_ROOT_USER=dommax
MINIO_ROOT_PASSWORD=dommax-local-only
S3_PORT=19000
S3_CONSOLE_PORT=19001

# Подпись сессий мини-приложения, не короче 16 символов. Только для локального запуска.
# Сервер: случайная строка (openssl rand -hex 32).
SESSION_SECRET=local-only-session-secret-change-me
# Демо-вход по ролям для проверки без MAX (POST /api/v1/auth/demo, ?demo=resident в браузере).
DEMO_AUTH_ENABLED=true

# Бот: off | polling | webhook. Локально off: бот не нужен, чтобы проверить API и мини-приложение.
# Сервер: webhook, токен бота из кабинета MAX и секрет 5-256 символов из A-Z a-z 0-9 _ -
BOT_MODE=off
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=

# Геокодер на данных OpenStreetMap: адрес при «Найти дома рядом» и координаты при импорте домов.
# Публичный Nominatim: не больше 1 запроса в секунду, User-Agent с названием и контактом, без массового импорта.
# Для пилота — свой Nominatim. Пусто — геокодер выключен.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=dom-max/1.0 (+https://max.ru/t105_hakaton_max_bot)

# Подсказка категории через self-hosted LLM (необязательно). Без этих строк работают ключевые слова.
# Включить: раскомментировать обе строки; первый запуск скачает модель (около 2,5 ГБ, в памяти около 4 ГБ).
# COMPOSE_PROFILES=llm
# OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
