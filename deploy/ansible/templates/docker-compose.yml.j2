services:
  web:
    image: "{{ release_registry }}/web:{{ image_tag }}"
    container_name: "{{ env_config.container_name_web | default('max-web') }}"
    restart: unless-stopped
    ports:
      - "{{ env_config.bind_ip | default('127.0.0.1') }}:{{ env_config.host_port | default(10380) }}:80"
    depends_on:
      - api
    networks:
      - {{ env_config.docker_network | default('postgres-max') }}

  api:
    image: "{{ release_registry }}/api:{{ image_tag }}"
    container_name: "{{ env_config.container_name_api | default('max-api') }}"
    restart: unless-stopped
    env_file:
      - .env
    networks:
      - {{ env_config.docker_network | default('postgres-max') }}

networks:
  {{ env_config.docker_network | default('postgres-max') }}:
    name: {{ env_config.docker_network | default('postgres-max') }}
    driver: bridge
    external: true
