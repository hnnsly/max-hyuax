{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "hack-docs/design/prototype"],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "task",
      "runtimeArgs": ["run"],
      "port": 8080
    },
    {
      "name": "miniapp",
      "runtimeExecutable": "task",
      "runtimeArgs": ["miniapp:dev"],
      "port": 5173
    },
    {
      "name": "api-8081",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set HTTP_ADDR=:8081&& task run"],
      "port": 8081
    },
    {
      "name": "api-8081-llm",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set HTTP_ADDR=:8081&& set OLLAMA_URL=http://localhost:11435&& task run"],
      "port": 8081
    },
    {
      "name": "api-8082",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set HTTP_ADDR=:8082&& task run"],
      "port": 8082
    },
    {
      "name": "miniapp-8082",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_PROXY=http://localhost:8082&& task miniapp:dev"],
      "port": 5173
    },
    {
      "name": "miniapp-build-8082",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd miniapp && set API_PROXY=http://localhost:8082&& npx vite preview --port 4174 --strictPort"],
      "port": 4174
    },
    {
      "name": "miniapp-8081",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_PROXY=http://localhost:8081&& task miniapp:dev"],
      "port": 5173
    }
  ]
}
