{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-prototype",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "4173", "--bind", "127.0.0.1", "--directory", "hack-docs/design/prototype"],
      "port": 4173
    },
    {
      "name": "api",
      "runtimeExecutable": "task",
      "runtimeArgs": ["run"],
      "port": 8080
    },
    {
      "name": "miniapp",
      "runtimeExecutable": "task",
      "runtimeArgs": ["miniapp:dev"],
      "port": 5173
    },
    {
      "name": "api-8081",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set HTTP_ADDR=:8081&& task run"],
      "port": 8081
    },
    {
      "name": "miniapp-8081",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set API_PROXY=http://localhost:8081&& task miniapp:dev"],
      "port": 5173
    }
  ]
}
