# Локальная разработка: этот файл читает Taskfile (dotenv). На сервере используется deploy/.env.
DOMAIN=localhost
POSTGRES_PASSWORD=dommax
DATABASE_URL=postgres://dommax:dommax@localhost:5432/dommax?sslmode=disable

HTTP_ADDR=:8080
SESSION_SECRET=local-dev-session-secret-change-on-server
DEMO_AUTH_ENABLED=true

