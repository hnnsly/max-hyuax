# Локальная разработка: этот файл читает Taskfile (dotenv). На сервере используется deploy/.env.
DOMAIN=localhost

# База данных PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dommax
POSTGRES_PASSWORD=dommax
POSTGRES_DB=dommax
POSTGRES_SSLMODE=disable
DATABASE_URL=postgres://dommax:dommax@localhost:5432/dommax?sslmode=disable

HTTP_ADDR=:8080
SESSION_SECRET=local-dev-session-secret-change-on-server
DEMO_AUTH_ENABLED=true

# Бот: off | polling | webhook. Локально по умолчанию выключен, чтобы не спорить за события с сервером.
BOT_MODE=off
MAX_BOT_TOKEN=f9LHodD0cOL2NmKbuATgdnneiJ5RFSQyh_YHIO6Tztr5VIn7MS536x4ixpeAAke_2GTrMtXrjl-lySJ-AbXl
MAX_API_INSECURE_TLS=true

# Геокодер OpenStreetMap (ADR-016): не больше 1 запроса в секунду, без массового импорта.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=dom-max/1.0 (+https://max.ru/t105_hakaton_max_bot)

# Фото: без S3_ENDPOINT api пишет их на диск (PHOTOS_DIR, по умолчанию backend/data/photos).
# С MinIO из task s3 раскомментировать четыре строки ниже.
# S3_ENDPOINT=localhost:19000
# S3_ACCESS_KEY=dommax
# S3_SECRET_KEY=dommax-local-only
# S3_BUCKET=photos
# MinIO для task test:integration (поднимает task s3).
TEST_S3_ENDPOINT=localhost:19000
TEST_S3_ACCESS_KEY=dommax
TEST_S3_SECRET_KEY=dommax-local-only
